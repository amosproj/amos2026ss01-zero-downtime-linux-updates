{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/usr/share/pki/containers/cosign.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ]
        },
        "containers-storage": {
            "": [{ "type": "insecureAcceptAnything" }]
        }
    }
}
