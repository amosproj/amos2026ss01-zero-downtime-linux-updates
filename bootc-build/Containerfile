ARG FEDORA_VERSION=latest
ARG DEV_MODE=false

# Compile the orchestrator binary.
#
# cargo-chef splits dependency compilation into its own layer keyed only on the
# Cargo manifests (recipe.json), so editing our own sources no longer forces a
# full recompile of every crate. That layer is exported/restored by the build
# cache (in CI: cache-to/from type=gha,mode=max in container-orchestrator.yml;
# locally: podman's --layers), which is otherwise wasted because `COPY . .`
# invalidates everything after it.
# https://images.redhat.com
FROM registry.access.redhat.com/hi/rust:1.95-builder AS chef
RUN dnf install -y tpm2-tss-devel pkgconf-pkg-config && dnf clean all

RUN cargo install cargo-chef --locked
WORKDIR /workspace

# Distill the dependency "recipe" from the Cargo manifests only.
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /workspace/recipe.json recipe.json
# Cook (compile) just the orchestrator's dependencies. This layer is reused
# across source-only changes because recipe.json only changes when
# Cargo.toml/Cargo.lock do. Scoped to amos-orchestrator so we don't compile unnecessary crates.
# Build dependencies - this is the caching Docker layer!
RUN cargo chef cook --release --package amos-orchestrator --recipe-path recipe.json
# Build application
COPY . .
RUN cargo build --package amos-orchestrator --release


FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

# Install following components:
#  - greenboot: health checks after bootc switch
#  - tpm2: library for TPM communication (tss-esapi crate only FFI's with it) (tpm2-tools only for debugging)
#  - cloud-init: so the resulting disk image is provisionable via NoCloud (+ other lima dependencies)
# Finally, clean up DNF cache to reduce image size (useless in a separate layer)
RUN dnf install -y \
    greenboot greenboot-default-health-checks \
    tpm2-tss tpm2-tools \
    openssh-server cloud-init sshfs \
    && dnf clean all

# Copy the compiled binary from the build stage
COPY --from=builder /workspace/target/release/amos-orchestrator /usr/libexec/amos-orchestrator

# Install the systemd unit and enable it
COPY bootc-build/orchestrator.service /etc/systemd/system/orchestrator.service
RUN systemctl enable orchestrator.service

# Enable the podman socket so the orchestrator can access it
RUN systemctl enable podman.socket

