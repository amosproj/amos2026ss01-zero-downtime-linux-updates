meta {
  name: 08 Assign App To Device
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/app-assignments
  body: json
  auth: inherit
}

body:json {
  {
    "application_config_id": {{appConfigId}},
    "device_id": {{demoDeviceId}}
  }
}

vars:post-response {
  appAssignmentId: res.body.id
}

docs {
  `POST /app-assignments` — mark the config as *desired state* for the
  scanner IPC. On its next poll the orchestrator pulls the image and starts
  the container.

  **Watch the log stream tab:** within ~a minute the pull/deploy messages
  and then the app's own output (`NAME = AMOS`, heartbeat counter) appear.
}
