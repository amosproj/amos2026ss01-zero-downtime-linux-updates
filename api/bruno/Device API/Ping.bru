meta {
  name: Ping
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/device/ping
  body: json
  auth: bearer
}

auth:bearer {
  token: {{deviceJwt}}
}

body:json {
  {
    "uptime_secs": 1234
  }
}

docs {
  `PUT /device/ping` — aliveness signal; upserts the device's last-seen
  timestamp and uptime (visible in *User API → Reported State → List Pings*).
  The body is optional; without it `uptime_secs` is stored as null.
  Returns 201.
}
