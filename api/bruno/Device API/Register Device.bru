meta {
  name: Register Device
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "uuid": "019f4785-419a-7aae-b79d-f0ad81510156",
    "serial_number": "{{edge3Serial}}",
    "endorsement_public_key": "-----BEGIN PUBLIC KEY-----\n…TPM endorsement key…\n-----END PUBLIC KEY-----\n",
    "signing_public_key": "-----BEGIN PUBLIC KEY-----\n…TPM signing key…\n-----END PUBLIC KEY-----\n"
  }
}

docs {
  `POST /register` — the only unauthenticated route. The device presents
  its identity; if `serial_number` + `endorsement_public_key` match a
  pending registration (byte-for-byte), the server creates the device
  record, stores the `signing_public_key` for future JWT verification, and
  consumes the pending entry. Returns 201, or 400 if nothing matches.

  Normally called by the orchestrator on boot — not by hand.
}
