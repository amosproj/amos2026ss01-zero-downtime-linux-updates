meta {
  name: Create App Assignment
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/app-assignments
  body: json
  auth: inherit
}

body:json {
  {
    "application_config_id": 1,
    "device_id": 1,
    "group_id": null
  }
}

docs {
  `POST /app-assignments` — assign a config to a device or group. Exactly
  one of `device_id` / `group_id` must be set. Returns 201.
}
