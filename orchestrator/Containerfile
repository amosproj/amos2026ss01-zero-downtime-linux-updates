
# Compile the orchestrator binary
FROM rust:1-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the full Cargo workspace
COPY Cargo.toml Cargo.lock ./
COPY common/       common/
COPY orchestrator/ orchestrator/
COPY api-mock-server/ api-mock-server/
COPY security-module/ security-module/
COPY src/          src/

RUN cargo build --release -p amos-orchestrator

# Bootable OS image (fedora-bootc)
FROM quay.io/fedora/fedora-bootc:latest

RUN dnf -y install podman systemd curl && \
    dnf clean all

# Copy the compiled binary from the build stage
COPY --from=builder /build/target/release/amos-orchestrator /usr/local/bin/amos-orchestrator

# Install the systemd unit and enable it
COPY orchestrator/orchestrator.service /etc/systemd/system/orchestrator.service
RUN systemctl enable orchestrator.service
