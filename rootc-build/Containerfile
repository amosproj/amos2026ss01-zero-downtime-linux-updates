ARG FEDORA_VERSION=latest

# Compile the orchestrator binary
FROM docker.io/rust:1.95-slim AS builder
COPY . /workspace
WORKDIR /workspace
RUN cargo build --package amos-orchestrator --release

ARG FEDORA_VERSION=latest
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

# Copy the compiled binary from the build stage
COPY --from=builder /workspace/target/release/amos-orchestrator /usr/local/bin/amos-orchestrator

# Install the systemd unit and enable it
COPY rootc-build/orchestrator.service /etc/systemd/system/orchestrator.service
RUN systemctl enable orchestrator.service

# Install Greenboot health checks
RUN dnf -y install greenboot greenboot-default-health-checks && \
    dnf clean all

# Install cloud-init so the resulting disk image is provisionable via NoCloud
# (consumed by Lima, libvirt, virt-install, and most cloud providers).
RUN dnf -y install cloud-init && \
    dnf clean all

RUN find /usr/lib/systemd /etc/systemd -name "cloud*" 2>/dev/null || echo "No cloud-init units found"
RUN systemctl enable --root=/ cloud-init.service cloud-init-local.service \
                     cloud-config.service cloud-final.service

# Embed the Cosign public key and container policy so podman enforces
# signature verification when pulling future OS updates.
# Policy goes to both paths: /usr (immutable, tamper-resistant) and /etc
# (mutable, takes precedence — keeps both in sync via the image).
# Key goes to /usr only so it cannot be replaced by a local root user.
RUN mkdir -p /usr/share/pki/containers /usr/share/containers
COPY cosign.pub /usr/share/pki/containers/cosign.pub
COPY container-policy.json /usr/share/containers/policy.json
COPY container-policy.json /etc/containers/policy.json