[Unit]
Description=Zero-Downtime Linux Update Orchestrator
Documentation=https://github.com/amosproj/amos2026ss01-zero-downtime-linux-updates
# Order only on network-online.target.
# The config file (/etc/amos/config.toml) is written by cloud-init's write_files
# stage, which completes before network-online.target, so the config is already
# present by the time we start.
After=network-online.target
Wants=network-online.target


[Service]
Type=simple
ExecStart=/usr/local/bin/amos-orchestrator --config /etc/amos/config.toml
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
